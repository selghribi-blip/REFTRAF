# Traffic Bot Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# Zyte API (Scrapy Cloud) - Get from https://app.zyte.com/
ZYTE_API_KEY=your_zyte_api_key_here

# MongoDB Atlas - Get from https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/traffic_bot?retryWrites=true&w=majority

# BrowserStack - Get from https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# Target URL to crawl
TARGET_URL=https://www.example.com/

# Free Proxy List URL (optional - uses built-in sources if not set)
FREE_PROXY_LIST_URL=https://example.com/proxies.txt

# Scrapy Settings
LOG_LEVEL=INFO
DOWNLOAD_DELAY=3
CONCURRENT_REQUESTS=2

# BrowserStack Settings
BROWSERSTACK_BROWSER=chrome
BROWSERSTACK_OS=Windows
BROWSERSTACK_OS_VERSION=11
BROWSERSTACK_LOCAL=false

# Run Mode: scrapy, browserstack, local, or both
RUN_MODE=both

# Session Settings
MAX_PAGES_PER_RUN=20
MAX_ADS_PER_RUN=50
MAX_FORMS_PER_RUN=10
